# Project-specific
serp_api_key.py
model.tar.gz

outputs/
data/FinancialPhraseBank-v1.0.zip
data/FinancialPhraseBank-v1.0/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Native extensions
*.so
*.pyd

# Packaging (setuptools / pip)
build/
dist/
.eggs/
*.egg-info/

# Virtual environments & local secrets
# Leading slashes matter: unanchored "env/" matches a directory named env at ANY
# depth, which silently swallowed terraform/env/prod.tfvars.
.env
.venv
/venv/
/env/

# Tests & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Type checking
.mypy_cache/

# Terraform local build artifacts
# backend.hcl and .terraform.lock.hcl are deliberately tracked: CI works from a fresh
# clone, so `init -backend-config=backend.hcl` needs the file present, and an untracked
# lock lets CI resolve a different provider version than the one planned locally.
terraform/build/
terraform/terraform.tfvars
terraform/.terraform/

# Written by scripts/lambda-build-push.sh for local applies; CI passes -var instead.
terraform/image_tag.auto.tfvars

# Terraform state and other local artifacts (never commit)
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Machine specific
.DS_Store

# Frontend (Vite)
web/node_modules/
web/dist/
