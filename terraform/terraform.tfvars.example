# Local overrides only. CI does not read this file — it applies env/prod.tfvars plus
# TF_VAR_* environment variables. Copy to terraform.tfvars for workstation applies:
#
#   terraform apply -var-file=env/prod.tfvars
#
# terraform.tfvars is loaded automatically on top of that, so it only needs the values
# you want to differ from production. Do not commit it.

# Secret ARNs are deliberately absent from env/prod.tfvars because they carry the
# account ID. Set them here for local applies, and as GitHub Actions repository
# variables (TF_VAR_*) for CI.
# google_secret_arn             = "arn:aws:secretsmanager:region:account:secret:finsense/google"
# openai_secret_arn             = "arn:aws:secretsmanager:region:account:secret:finsense/openai"
# reddit_credentials_secret_arn = "arn:aws:secretsmanager:region:account:secret:finsense/reddit"

# image_tag is written to image_tag.auto.tfvars (gitignored, auto-loaded) by
# scripts/lambda-build-push.sh. CI passes -var image_tag=... instead.

# Handy local overrides:
# cors_allow_origins  = ["http://localhost:5173"]
# s3_force_destroy    = true
# ingestion_max_articles = 5

# Note: the SageMaker model, endpoint configuration and endpoint are NOT Terraform
# resources. The model_promote Lambda creates and rolls them forward when a model
# package is approved — see the model registry note in modules/sagemaker/main.tf.
